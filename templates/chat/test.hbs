<div class="cops carte-jet {{issue}}">
  <header>
    <h3>{{titre}}</h3>
    <span class="sous-titre">{{sousTitre}}</span>
  </header>

  <div class="parametres">
    <span title="{{caracValeur}} (caractéristique){{#each mods}} {{copsSigne valeur}} ({{label}}){{/each}}">{{nbDes}}d10</span>
    <span>seuil {{seuil}}+{{#if sansCompetence}} (sans compétence){{/if}}</span>
    {{#if difficulte}}<span>difficulté {{difficulte}}</span>{{else}}<span>opposition</span>{{/if}}
  </div>
  {{#if mods.length}}
  <div class="mods">
    {{#each mods}}<span class="mod">{{label}} {{copsSigne valeur}}</span>{{/each}}
  </div>
  {{/if}}

  {{#if des.length}}
  <ol class="des">
    {{#each des}}
    <li class="de {{#if succes}}succes{{/if}} {{#if critique}}critique{{/if}} {{#if bleu}}bleu{{/if}} {{#if relance}}relance{{/if}} {{#if nouveau}}nouveau{{/if}}"
        title="{{#if bleu}}Dé bleu (stage) : une réussite compte double. {{/if}}{{#if relance}}Dé relancé (stage). {{/if}}{{#if nouveau}}Dé de relance (stage). {{/if}}{{#if critique}}Réussite critique : relancé{{/if}}">{{valeur}}</li>
    {{/each}}
  </ol>
  {{/if}}
  {{#if notesStages.length}}
  <div class="notes-stages">{{#each notesStages}}<span><i class="fa-solid fa-graduation-cap"></i> {{this}}</span>{{/each}}</div>
  {{/if}}

  <div class="issue">
    <strong>{{succes}} réussite(s)</strong>
    {{#if ancienneteUtilisee}}<span class="anciennete">dont {{ancienneteUtilisee}} d'ancienneté</span>{{/if}}
    <div>{{issueLabel}}</div>
    {{#if note}}<div class="note">{{note}}</div>{{/if}}
  </div>

  {{#if peutAnciennete}}
  <button type="button" data-cops-action="anciennete"><i class="fa-solid fa-medal"></i> Dépenser 1 point d'ancienneté ({{#if ancienneteDouble}}+2 réussites, stage{{else}}+1 réussite{{/if}})</button>
  {{/if}}

  {{#if impacts.length}}
  <div class="impacts">
    <h4>{{#if rafale}}Impacts de la rafale{{else}}Impact{{/if}}{{#if (copsEq issue "opposition")}} (si l'attaquant l'emporte){{/if}}</h4>
    {{#each impacts}}
    <div class="impact {{#if rate}}rate{{/if}}">
      {{#if rate}}
      <span>Balle {{numero}} : {{locLabel}}</span>
      {{else}}
      <span class="loc">{{#if localise}}{{locJet}} → {{locLabel}} ({{copsSigne locMod}}){{else}}{{locLabel}}{{/if}}</span>
      <span class="deg" title="{{detailDegats}}">{{degats}} pts de puissance{{#if bonusDeg}} (dont +{{bonusDeg}} stage){{/if}}{{#if ignoreArmure}} · armure ignorée{{/if}}</span>
      <span class="fa">FA {{faDiff}}</span>
      {{#if @root.stage}}
      <div class="stage-impact">
        <span class="titre-stage" title="{{@root.stage.sources}}"><i class="fa-solid fa-graduation-cap"></i> Marge{{#if (copsEq stageReste null)}} (limitée par votre avance sur l'adversaire){{else}} restante : {{stageReste}}{{/if}}</span>
        {{#if @root.stage.degats}}
        <span>Dommages
          <a data-cops-action="stage" data-index="{{index}}" data-champ="deg" data-delta="-1" title="Retirer 1">−</a>
          +{{bonusDeg}}
          <a data-cops-action="stage" data-index="{{index}}" data-champ="deg" data-delta="1" title="Ajouter 1">+</a>
        </span>
        {{/if}}
        {{#if peutLoc}}
        <span>Localisation
          <a data-cops-action="stage" data-index="{{index}}" data-champ="loc" data-delta="-1" title="−1 au jet de localisation">−</a>
          {{copsSigne locShift}}
          <a data-cops-action="stage" data-index="{{index}}" data-champ="loc" data-delta="1" title="+1 au jet de localisation">+</a>
        </span>
        {{/if}}
        {{#if @root.stage.pointFaible}}
        <a data-cops-action="stage" data-index="{{index}}" data-champ="pf" class="{{#if ignoreArmure}}actif{{/if}}" title="Dépense 2 points de marge : ignore l'armure de la cible">Point faible</a>
        {{/if}}
      </div>
      {{/if}}
      <button type="button" data-cops-action="appliquer" data-index="{{index}}" title="Applique aux tokens ciblés (ou sélectionnés) : protection, dés de localisation, PV">
        <i class="fa-solid fa-heart-crack"></i> Appliquer
      </button>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>
