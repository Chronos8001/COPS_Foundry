<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
    <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Nom du stage"/></h1>
  </header>
  <section class="champs grid grid-3col">
    <label>Niveau<input type="number" name="system.niveau" value="{{system.niveau}}" min="1" max="3"/></label>
    <label>Prérequis<input type="text" name="system.prerequis" value="{{system.prerequis}}"/></label>
    <label>Cumul<input type="text" name="system.cumul" value="{{system.cumul}}"/></label>
  </section>
  <h3>Bonus et capacités spéciales</h3>
  {{editor descriptionHTML target="system.description" button=true owner=owner editable=editable}}
</form>
