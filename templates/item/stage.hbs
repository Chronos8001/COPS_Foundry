<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
    <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Nom du stage"/></h1>
  </header>
  <section class="champs grid grid-3col">
    <label>Niveau (coût : {{system.cout}} pt{{#unless (copsEq system.cout 1)}}s{{/unless}} de stage)<input type="number" name="system.niveau" value="{{system.niveau}}" min="1" max="3" data-dtype="Number"/></label>
    <label>Cumul<input type="text" name="system.cumul" value="{{system.cumul}}"/></label>
    <label>Capacité spéciale choisie
      {{#if capacites.length}}
      <select name="system.capacite">
        <option value="">—</option>
        {{#each capacites}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
      </select>
      {{else}}
      <input type="text" name="system.capacite" value="{{system.capacite}}"/>
      {{/if}}
    </label>
  </section>
  <section class="champs grid grid-2col">
    <label>{{#if cibles.length}}Compétence visée{{else}}Domaine (milieu, quartier, culture…){{/if}}
      {{#if cibles.length}}
      <select name="system.cible">
        <option value="">— Toutes —</option>
        {{#each cibles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{else}}
      <input type="text" name="system.cible" value="{{system.cible}}"/>
      {{/if}}
    </label>
    <label>Prérequis<input type="text" name="system.prerequis" value="{{system.prerequis}}"/></label>
  </section>
  {{#if effets.length}}
  <p class="verif-stage ok"><i class="fa-solid fa-gears"></i> Automatisé : {{#each effets}}{{this}}{{#unless @last}} ; {{/unless}}{{/each}}.</p>
  {{/if}}
  {{#if verif}}
  <p class="verif-stage {{#if verif.ok}}ok{{else}}ko{{/if}}">
    {{#if verif.ok}}<i class="fa-solid fa-check"></i> Prérequis remplis par {{item.parent.name}}.{{else}}<i class="fa-solid fa-xmark"></i> Manque : {{#each verif.manques}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}.{{/if}}
    {{#if verif.aVerifier.length}}<br/>À vérifier : {{#each verif.aVerifier}}{{this}}{{#unless @last}} ; {{/unless}}{{/each}}.{{/if}}
  </p>
  {{/if}}
  <h3>Bonus et capacités spéciales</h3>
  {{editor descriptionHTML target="system.description" button=true owner=owner editable=editable}}
</form>
